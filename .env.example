# Copy this file to .env — or set these as environment variables on your host (Railway/Render)

# Your bot token from https://discord.com/developers/applications -> Bot -> Token  (REQUIRED)
DISCORD_TOKEN=your-bot-token-here

# Your application ID (from the Developer Portal -> General Information)
CLIENT_ID=

# Optional: a server (guild) ID for instant slash-command registration during testing.
# Leave empty to register commands globally (works everywhere, may take up to 1 hour to appear).
GUILD_ID=

# ---- Key system ----

# Prefix used for generated keys (e.g. LSN -> LSN-XXXXX-XXXXX-XXXXX)
KEY_PREFIX=LSN

# Optional: pre-set the bot owner (comma-separated user IDs).
# Not needed — just run /claimowner in Discord: the first person to run it becomes the owner.
OWNER_IDS=

# How many days a user must wait between HWID resets (default 7)
RESET_COOLDOWN_DAYS=7

# Seconds for the /keydrop countdown (3-60, default 10)
KEYDROP_COUNTDOWN=10

# Optional: link shown on panels (e.g. your support server)
SUPPORT_URL=

# Public URL of your bot (Railway domain) — used in script loadstrings
# AND to build the OAuth redirect URI for the website's Discord login.
# Example: https://your-service.up.railway.app
PUBLIC_URL=

# ---- Website "Login with Discord" (OAuth2 -> /callback) ----
# DISCORD_CLIENT_ID: the Application ID (same as CLIENT_ID above).
# DISCORD_CLIENT_SECRET: Developer Portal -> OAuth2 -> Client Secret.
# The redirect URI the bot sends is PUBLIC_URL + "/callback" (or set
# DISCORD_OAUTH_REDIRECT_URI explicitly). It must EXACTLY match a Redirect
# URI registered in Developer Portal -> OAuth2 -> Redirects.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# DISCORD_OAUTH_REDIRECT_URI=https://your-service.up.railway.app/callback

# Optional: "Back to site" button shown after a successful Discord login.
WEBSITE_URL=

# Credit shown on panels / protected scripts (default: Zwoz)
CREDIT_NAME=Zwoz

# ---- Validation API (for your scripts) ----
# Optional! If you leave this empty, the bot generates a random token on first
# start, saves it in data/settings.json and prints it in the logs.
API_TOKEN=
API_PORT=3000

# Optional: path to store data (defaults to ./data). On Railway use a volume, e.g. /data
# DATA_DIR=/data
