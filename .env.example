# ==============================================================================
# PROTECT-VMAX — Environment Variables (.env)
# Set these locally in .env or in Railway (Service -> Variables tab)
# ==============================================================================

# ---- Discord Bot Authentication (REQUIRED) ----
# Developer Portal -> Applications -> Your Bot -> Bot -> Reset Token
DISCORD_TOKEN=your-bot-token-here

# Developer Portal -> Applications -> Your Bot -> General Information -> Application ID
CLIENT_ID=

# Optional: a server (guild) ID for instant slash-command registration during testing.
# Leave empty to register commands globally (works everywhere, takes a few minutes to 1 hour).
GUILD_ID=

# ---- Railway Web & Public Domain ----
# Public URL of your Railway web service (e.g. https://your-service.up.railway.app)
# Auto-detected on Railway if omitted, or specify manually:
PUBLIC_URL=https://discord-project-production-a058.up.railway.app

# Port for the web landing page and validation API (Railway provides PORT automatically)
PORT=3000
API_PORT=3000

# ---- Website "Login with Discord" (OAuth2 -> /callback) ----
# DISCORD_CLIENT_ID: Developer Portal -> General Information -> Application ID
# DISCORD_CLIENT_SECRET: Developer Portal -> OAuth2 -> Client Secret
# Redirect URI to add in Developer Portal -> OAuth2 -> Redirects:
# https://your-service.up.railway.app/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# DISCORD_OAUTH_REDIRECT_URI=https://your-service.up.railway.app/callback

# Optional: URL to redirect users back to after Discord login
WEBSITE_URL=

# ---- Key & Whitelist System ----
# Prefix used for generated keys (e.g. LSN -> LSN-XXXXX-XXXXX-XXXXX)
KEY_PREFIX=LSN

# Optional: pre-set bot owner Discord IDs (comma-separated).
# Not required — run /claimowner in your Discord server to claim ownership.
OWNER_IDS=

# Cooldown days between HWID resets (default 7)
RESET_COOLDOWN_DAYS=7

# Seconds for the /keydrop countdown (3-60, default 10)
KEYDROP_COUNTDOWN=10

# Optional: link shown on panels (e.g. your support server)
SUPPORT_URL=

# Credit shown on panels / protected scripts (default: Zwoz)
CREDIT_NAME=Zwoz

# ---- Validation API Security ----
# Optional: Bearer token for admin endpoints (/api/v1/status, /api/v1/key).
# If left empty, a secure token is auto-generated on first boot and printed in logs.
API_TOKEN=

# ---- VMax Forwarder ----
# Optional but strongly recommended: dedicated secret used to encrypt saved webhook URLs at rest.
# If empty, the app falls back to DISCORD_TOKEN / DISCORD_CLIENT_SECRET when available.
FORWARDER_SECRET_KEY=

# Comma-separated Discord user IDs allowed to manage the web dashboard in addition to OWNER_IDS.
FORWARDER_DASHBOARD_USER_IDS=

# Default hard cap for webhook uploads per file (in MB). Individual rules can set a smaller limit.
FORWARDER_WEBHOOK_MAX_MB=8

# Attachment download timeout when relaying files from Discord (milliseconds).
FORWARDER_DOWNLOAD_TIMEOUT_MS=20000

# Retained duplicate/history records and dashboard log entries.
FORWARDER_HISTORY_LIMIT=10000
FORWARDER_LOG_LIMIT=2000

# Persistent data path (defaults to ./data). On Railway, attach a Volume at /data:
# DATA_DIR=/data
